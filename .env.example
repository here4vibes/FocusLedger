# FocusLedger environment variables. Copy to .env and fill in.
# Placeholders only; never commit real values. Production values live in the
# Render "focusledger" env group. Every process.env.* the server, routes, lib,
# db, services and jobs read is listed here (CI, DRY_RUN and RENDER_GIT_COMMIT
# are set by the platform or by hand for one run).

# ── Core ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/focusledger
JWT_SECRET=change-me
SESSION_SECRET=change-me
SENTRY_DSN=
ADMIN_EMAILS=you@example.com
ALLOWED_ORIGIN=

# Public URLs used in emails, redirects and links
APP_URL=https://focusledger.net
APP_BASE_URL=https://focusledger.net
BASE_URL=https://focusledger.net
PRIMARY_URL=https://focusledger.net
RENDER_URL=

# ── AI ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT_FREE=100
AI_DAILY_LIMIT_PRO=500

# ── Email (Resend) ────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=FocusLedger <hello@focusledger.net>
MAILING_ADDRESS=

# ── Google (sign-in, Gmail, Calendar) ─────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=
GOOGLE_REDIRECT_URI=

# ── Microsoft / Yahoo email OAuth ─────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=
# Encrypts email OAuth tokens at rest (falls back to JWT_SECRET)
TOKEN_ENCRYPTION_KEY=

# ── Plaid ─────────────────────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=
# Encrypts Plaid access tokens (falls back to JWT_SECRET). Never change it in
# production: existing tokens could no longer be decrypted.
PLAID_ENCRYPTION_KEY=

# ── Stripe ────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_AUTOPILOT_MONTHLY=
STRIPE_PRICE_AUTOPILOT_ANNUAL=
STRIPE_PRICE_TANDEM_MONTHLY=
STRIPE_PRICE_TANDEM_ANNUAL=
STRIPE_LINK_AUTOPILOT_MONTHLY=
STRIPE_LINK_AUTOPILOT_ANNUAL=
STRIPE_LINK_TANDEM_MONTHLY=
STRIPE_LINK_TANDEM_ANNUAL=

# ── iOS in-app purchase (RevenueCat) ──────────────────
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_ENTITLEMENT=

# ── Push ──────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:hello@focusledger.net
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8=
APNS_BUNDLE_ID=

# ── Document vault storage (S3-compatible) ────────────
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
